{%- comment -%}
  Split feature: square image one side, copy the other. Copy comes from the language files
  (key chosen by "Content"), so every variant ships in English and 中文.
  "set"  — the set of five, with live price/savings from the picked product + add-to-cart
  "feel" — the texture story (juicy / glossy / balmy), links to the shades
{%- endcomment -%}
{%- assign key = section.settings.content -%}
{%- assign product = section.settings.product -%}
<section id="{{ section.settings.anchor | default: section.id }}" class="{% if section.settings.border %}border-top{% endif %}">
  <div class="container" style="padding: 0; max-width: 1400px;">
    <div class="split split--{{ section.settings.scheme }}{% if section.settings.image_right %} split--reverse{% endif %}">
      <div class="split__media">
        {%- assign img = section.settings.image | default: product.featured_image -%}
        {%- render 'media-well', image: img -%}
      </div>
      <div class="split__copy">
        {%- if key == 'feel' -%}
          <p class="u-mini muted">{{ 'feel.eyebrow' | t }}</p>
        {%- endif -%}
        <h2 class="h2 mt-1">{{ key | append: '.title' | t }}</h2>
        <p class="lede mt-2" style="max-width: 26rem;">{{ key | append: '.body' | t }}</p>

        {%- if product != blank -%}
          {%- assign v = product.selected_or_first_available_variant -%}
          <p class="mt-2 small">
            <span class="medium">{% render 'price', price: v.price %}</span>
            {%- if v.compare_at_price > v.price -%}
              {%- assign saving = v.compare_at_price | minus: v.price | money_without_trailing_zeros -%}
              <span class="accent"> — {{ 'set.save' | t: amount: saving }}</span>
            {%- endif -%}
          </p>
          {%- form 'product', product, class: 'mt-3' -%}
            <input type="hidden" name="id" value="{{ v.id }}">
            <button type="submit" class="btn" {% unless v.available %}disabled{% endunless %}>
              {%- if v.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
            </button>
          {%- endform -%}
          <a class="link-cta mt-2" style="align-self: flex-start;" href="{{ product.url }}">{{ 'set.details' | t }}</a>
        {%- elsif section.settings.link != blank -%}
          <a class="link-cta mt-3" style="align-self: flex-start;" href="{{ section.settings.link }}">{{ key | append: '.cta' | t }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "select", "id": "content", "label": "Content", "default": "set",
      "options": [ { "value": "set", "label": "The set of five" }, { "value": "feel", "label": "The feel (texture)" } ] },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's first image." },
    { "type": "product", "id": "product", "label": "Product (adds price + add to cart)" },
    { "type": "url", "id": "link", "label": "Link (when no product)" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "paper",
      "options": [ { "value": "paper", "label": "White" }, { "value": "mist", "label": "Mist" }, { "value": "ink", "label": "Ink" }, { "value": "dew", "label": "Dew red" } ] },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "border", "label": "Top border", "default": true },
    { "type": "text", "id": "anchor", "label": "Anchor id" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
