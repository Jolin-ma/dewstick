{%- comment -%} The reviews slot. Honest by design: no fabricated reviews, ratings or counts. {%- endcomment -%}
<section id="note" class="section g12 founder">
  <h2 class="h2 founder__head">{{ 'note.title' | t }}</h2>
  <div class="founder__body">
    <div class="prose measure">
      <p>{{ 'note.sub' | t }}</p>
      <p>{{ 'note.body' | t }}</p>
      <p>{{ 'home.note_sign' | t }}</p>
    </div>
    {%- if section.settings.collection != blank -%}
      <a class="btn btn--outline" href="{{ section.settings.collection.url }}">{{ 'hero.cta' | t }}</a>
    {%- endif -%}
  </div>
  <div class="founder__img">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1000 | image_tag:
        widths: '500, 720, 1000', sizes: '(min-width: 768px) 33vw, 100vw',
        loading: 'lazy', alt: section.settings.image.alt | escape }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Founder note",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "collection", "id": "collection", "label": "Button links to" }
  ],
  "presets": [{ "name": "Founder note" }]
}
{% endschema %}
