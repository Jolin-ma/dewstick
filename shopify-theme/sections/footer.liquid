{%- liquid
  assign home = routes.root_url
  if home == '/'
    assign home = ''
  endif
-%}
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="u-mini site-footer__label">{{ 'footer.about' | t }}</p>
      <ul>
        <li><a href="{{ home }}/#note">{{ 'nav.idea' | t }}</a></li>
        <li><a href="{{ home }}/#why">{{ 'nav.ingredients' | t }}</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'nav.shop' | t }}</a></li>
      </ul>
    </div>
    <div>
      <p class="u-mini site-footer__label">{{ 'footer.help' | t }}</p>
      <ul>
        {%- if section.settings.contact_email != blank -%}
          <li><a href="mailto:{{ section.settings.contact_email }}">{{ 'footer.contact' | t }}</a></li>
        {%- endif -%}
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
    <div>
      <p class="u-mini site-footer__label">{{ 'newsletter.heading' | t }}</p>
      {%- render 'newsletter-form', form_id: 'FooterNewsletter' -%}
    </div>
  </div>
  <div class="site-footer__base">
    <div class="container">
      <p>© {{ 'now' | date: '%Y' }} dewstick</p>
      {%- render 'lang-switch' -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@dewstick.com" },
    { "type": "link_list", "id": "menu", "label": "Extra help links", "info": "Store policies (Settings → Policies) are listed automatically." }
  ]
}
{% endschema %}
