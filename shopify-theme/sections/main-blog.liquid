<section class="section">
  <div class="container page-narrow">
    <h1 class="h2">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="mt-3" style="display: grid; gap: 32px;">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}">
            <p class="u-mini muted">{{ article.published_at | date: format: 'date' }}</p>
            <h2 class="medium mt-1" style="font-size: 1.25rem;">{{ article.title }}</h2>
            {%- if article.excerpt != blank -%}<div class="small muted mt-1">{{ article.excerpt | strip_html | truncate: 180 }}</div>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="mt-4 small">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
