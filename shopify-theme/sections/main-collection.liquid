{%- comment -%} Collection page. A product with shade variants is expanded into one card per shade. {%- endcomment -%}
<section class="section" style="padding-top: 3.6rem; margin-top: 0;">
  <div class="sec-head">
    <h1 class="h2">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="muted rte">{{ collection.description }}</div>{%- endif -%}
  </div>
  {%- paginate collection.products by 24 -%}
    <div class="g12 pgrid">
      {%- for product in collection.products -%}
        {%- if product.has_only_default_variant -%}
          {%- liquid
            assign desc_key = blank
            if product.id == section.settings.set_product.id
              assign desc_key = 'set.body'
            endif
          -%}
          {%- render 'product-card', product: product, desc_key: desc_key -%}
        {%- else -%}
          {%- for variant in product.variants -%}
            {%- render 'product-card', variant: variant -%}
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        <p class="muted">{{ 'collection.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="mt-4 center small">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "product", "id": "set_product", "label": "The set of five", "info": "Its card gets the set's one-line description." }
  ]
}
{% endschema %}
