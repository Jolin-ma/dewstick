<section class="section">
  <div class="container page-narrow">
    <h1 class="h2">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count == 0 -%}
      <p class="mt-2 muted">{{ 'cart.empty' | t }}</p>
      <a class="link-cta mt-3" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="mt-3">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <a href="{{ item.url }}">{%- render 'media-well', image: item.image, sizes: '96px' -%}</a>
            <div>
              <a href="{{ item.url }}" class="medium">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="small muted">{% render 'shade-swatch', shade: item.variant.option1 %}{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="qty mt-1" data-qty>
                <button type="button" data-step="-1" aria-label="{{ 'product.qty_down' | t }}">−</button>
                <label class="visually-hidden" for="Qty-{{ forloop.index }}">{{ 'product.quantity' | t }}</label>
                <input id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                <button type="button" data-step="1" aria-label="{{ 'product.qty_up' | t }}">+</button>
              </div>
              <div><a class="cart-line__remove muted" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div>
            </div>
            <p class="small">{% render 'price', price: item.final_line_price %}</p>
          </div>
        {%- endfor -%}

        <div class="cart-footer">
          <p><span class="u-mini muted">{{ 'cart.subtotal' | t }}</span>&nbsp; <span class="medium">{% render 'price', price: cart.total_price %}</span></p>
          <p class="small muted">{{ 'cart.taxes' | t }}</p>
          <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: flex-end;">
            <button type="submit" name="update" class="link-cta">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
