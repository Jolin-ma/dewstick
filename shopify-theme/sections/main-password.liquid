{%- comment -%} Storefront password page (dev stores are password-protected until a plan is picked). {%- endcomment -%}
<section class="password">
  <div>
    <p class="wordmark">dewstick</p>
    <p class="lede mt-2">{{ 'hero.body' | t }}</p>
    {%- if shop.password_message != blank -%}<p class="small muted mt-2">{{ shop.password_message }}</p>{%- endif -%}

    <div style="max-width: 24rem; margin: 32px auto 0; text-align: left;">
      <p class="u-mini muted" style="margin-bottom: 12px;">{{ 'newsletter.heading' | t }}</p>
      {%- render 'newsletter-form', form_id: 'PasswordNewsletter' -%}
    </div>

    <details class="mt-4 small">
      <summary class="u-mini" style="cursor: pointer;">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="field-row mt-2">
          <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
          <button type="submit" class="btn">{{ 'password.submit' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-note accent">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
    <div class="mt-4">{%- render 'lang-switch' -%}</div>
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
