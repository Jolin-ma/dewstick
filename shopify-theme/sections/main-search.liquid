<section class="section">
  <div class="container">
    <h1 class="h2">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="mt-3" style="max-width: 28rem;">
      <div class="field-row">
        <label class="visually-hidden" for="SearchQ">{{ 'search.title' | t }}</label>
        <input id="SearchQ" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn">{{ 'search.submit' | t }}</button>
      </div>
    </form>
    {%- if search.performed -%}
      <div class="grid grid--2 grid--md-3 mt-4">
        {%- for item in search.results -%}
          <a class="card" href="{{ item.url }}">
            {%- render 'media-well', image: item.featured_image, sizes: '(min-width: 768px) 33vw, 50vw' -%}
            <div class="card__body"><p class="medium">{{ item.title }}</p>
              {%- if item.price -%}<p class="card__price">{% render 'price', price: item.price %}</p>{%- endif -%}</div>
          </a>
        {%- else -%}
          <p class="muted">{{ 'search.none' | t: terms: search.terms }}</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
