{%- comment -%}
  Newsletter + photo wall above the footer. Tiles are not links: there is no real @dewstick
  account yet. The store photos carry their own type, so no overlay text on them.
{%- endcomment -%}
<section class="g12 news" aria-labelledby="news-title">
  <div class="news__form">
    <h2 id="news-title" class="h2">{{ 'newsletter.heading' | t }}</h2>
    <p class="mt-3 measure">{{ 'newsletter.privacy' | t }}</p>
    {%- render 'newsletter-form', form_id: 'FooterNewsletter', quiet: true -%}
  </div>
  <div class="wall" aria-label="@dewstick">
    {%- for block in section.blocks -%}
      <div class="wall__tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1000 | image_tag:
            widths: '360, 500, 720, 1000', sizes: '(min-width: 768px) 20vw, 33vw',
            loading: 'lazy', alt: block.settings.image.alt | escape }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter + photo wall",
  "class": "section-news",
  "blocks": [
    { "type": "tile", "name": "Photo", "settings": [ { "type": "image_picker", "id": "image", "label": "Image" } ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Newsletter + photo wall", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] }]
}
{% endschema %}
