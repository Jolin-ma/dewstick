{%- comment -%}
  Product grid built from the shade VARIANTS of one product (each shade is a variant of
  "dewstick tinted lip balm"), so one product page / one cart line type powers every card.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign wanted = section.settings.shades | downcase | remove: ' ' | split: ','
  assign cols = section.settings.columns
-%}
<section id="{{ section.settings.anchor | default: section.id }}" class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container">
    <div class="section-head">
      <h2 class="h2">{{ section.settings.heading_key | prepend: 'shades.' | append: '_title' | t }}</h2>
      {%- if section.settings.link != blank -%}
        <a class="link-cta" href="{{ section.settings.link }}">{{ 'shades.see_all' | t }}</a>
      {%- endif -%}
    </div>

    {%- if product == blank -%}
      <p class="muted">Pick a product in the theme editor.</p>
    {%- else -%}
      <div class="grid {% if cols == '5' %}grid--2 grid--md-5{% else %}grid--md-3{% endif %}">
        {%- for variant in product.variants -%}
          {%- assign shade = variant.option1 | downcase -%}
          {%- if section.settings.shades == blank or wanted contains shade -%}
            <a class="card" href="{{ variant.url }}">
              {%- render 'media-well',
                image: variant.featured_image,
                sizes: '(min-width: 768px) 33vw, 50vw' -%}
              <div class="card__body">
                <p class="medium">{% render 'shade-swatch', shade: shade %}{{ variant.option1 }}
                  <span class="faint">/ {{ shade | prepend: 'shades.' | append: '.tone' | t }}</span></p>
                {%- if cols != '5' -%}
                  <p class="muted">{{ shade | prepend: 'shades.' | append: '.line' | t }}</p>
                {%- endif -%}
                <p class="card__price{% if cols == '5' %} muted{% endif %}">{% render 'price', price: variant.price %}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_footnote -%}
        <p class="mt-3 small muted">{{ 'shades.footnote' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shade grid",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (shades are its variants)" },
    { "type": "text", "id": "shades", "label": "Only these shades", "info": "Comma-separated, e.g. nectar, poppy, blush. Leave blank for all." },
    { "type": "select", "id": "heading_key", "label": "Heading", "default": "all",
      "options": [ { "value": "hero", "label": "The hero shades" }, { "value": "all", "label": "All five shades" } ] },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "3",
      "options": [ { "value": "3", "label": "3" }, { "value": "5", "label": "5" } ] },
    { "type": "url", "id": "link", "label": "\"See all\" link" },
    { "type": "checkbox", "id": "show_footnote", "label": "Show price footnote", "default": false },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top spacing", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "For in-page links, e.g. shades" }
  ],
  "presets": [{ "name": "Shade grid" }]
}
{% endschema %}
