<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ shop.name | downcase }} — {{ 'password.title_plain' | t }}</title>
  {%- render 'meta-tags' -%}
  {%- render 'favicon' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
  {%- render 'css-variables' -%}
  {{ 'dewstick.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'dewstick.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="password-page">
  <main id="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
