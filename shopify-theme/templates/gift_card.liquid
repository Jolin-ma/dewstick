{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'gift_card.title' | t }} — dewstick</title>
  {{ 'dewstick.css' | asset_url | stylesheet_tag }}
  {%- render 'css-variables' -%}
  {{ content_for_header }}
</head>
<body>
  <main class="password">
    <div>
      <p class="wordmark">dewstick</p>
      <h1 class="h2 mt-2">{{ 'gift_card.title' | t }}</h1>
      <p class="lede mt-2">{% render 'price', price: gift_card.balance %}</p>
      <p class="mt-2 u-mini">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expired -%}<p class="small accent mt-1">{{ 'gift_card.expired' | t }}</p>{%- endif -%}
      <a class="link-cta mt-3" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a>
    </div>
  </main>
</body>
</html>
